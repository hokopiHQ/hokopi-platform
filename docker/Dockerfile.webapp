# Base
FROM node:24.18.0-bookworm-slim AS base
WORKDIR /app/webapp
# Add openssl for prisma generate
# Add ca-certificates for npm registry connexions
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY webapp/package*.json ./
RUN npm ci

# Dev (hot reload)
FROM base AS dev
CMD ["npm", "run", "dev"]

# Build step
FROM base AS build
WORKDIR /app
COPY shared/ shared
COPY backend backend
COPY webapp/ webapp
WORKDIR /app/backend
RUN npm ci
RUN DATABASE_URL=postgresql://user:password@localhost:5432/database npx prisma generate --generator shared
WORKDIR /app/webapp
RUN npm run build


# HTTP Serve step
FROM nginx:1-alpine-slim AS prod
RUN apk add --no-cache jq
COPY --chmod=755 docker/webapp.entryPoint.sh /docker-entrypoint.d/40-webappConfig.sh
COPY docker/nginx.webapp.conf /etc/nginx/nginx.conf
COPY --from=build /app/webapp/dist /usr/share/nginx/html
