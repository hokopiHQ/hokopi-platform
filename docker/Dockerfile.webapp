# Base
FROM node:24.18.0-bookworm-slim AS base
WORKDIR /app/frontend
# Add openssl for prisma generate
# Add ca-certificates for npm registry connexions
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY frontend/package*.json ./
RUN npm ci

# Dev (hot reload)
FROM base AS dev
CMD ["npm", "run", "dev"]

# Build step
FROM base AS build
WORKDIR /app
COPY shared/ shared
COPY backend backend
COPY frontend/ frontend
WORKDIR /app/backend
RUN npm ci
RUN if [ -f .env.production ]; then \
        NODE_ENV=production npx prisma generate --generator shared; \
    else \
        npx prisma generate --generator shared; \
    fi
WORKDIR /app/frontend
RUN npm run build


# HTTP Serve step
FROM nginx:1-alpine-slim AS prod
COPY docker/nginx.webapp.conf /etc/nginx/nginx.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html
